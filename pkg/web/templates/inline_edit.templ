package templates

import "fmt"

templ InlineCellDisplay(bikeId string, field string, value string, unit string, colorClass string) {
	<div
		hx-get={ fmt.Sprintf("/bikes/%s/inline-edit?field=%s", bikeId, field) }
		hx-target="this"
		hx-swap="outerHTML"
		class="group flex items-baseline justify-between cursor-pointer hover:bg-amber-500/10 p-1 -m-1 rounded transition select-none"
		title="Click to inline-edit"
	>
		<span class={ "font-bold font-mono text-sm", colorClass }>
			{ value }
			if unit != "" {
				<span class="text-xs font-normal text-slate-400 ml-0.5">{ unit }</span>
			}
		</span>
		<svg class="w-3.5 h-3.5 text-amber-400 opacity-0 group-hover:opacity-100 transition shrink-0 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path>
		</svg>
	</div>
}

templ InlineCellEdit(bikeId string, field string, value string, unit string, colorClass string) {
	<form
		hx-post={ fmt.Sprintf("/bikes/%s/inline-edit?field=%s", bikeId, field) }
		hx-target="this"
		hx-swap="outerHTML"
		class="flex items-center gap-1.5"
	>
		<input
			type="number"
			step="any"
			name="value"
			value={ value }
			autofocus
			class="w-20 bg-slate-950 border border-amber-500 rounded px-1.5 py-0.5 text-xs text-white font-mono focus:outline-none focus:ring-1 focus:ring-amber-500"
		/>
		<button
			type="submit"
			class="px-1.5 py-0.5 rounded bg-amber-500 text-slate-950 text-xs font-bold hover:bg-amber-400"
			title="Save"
		>
			✓
		</button>
		<button
			type="button"
			hx-get={ fmt.Sprintf("/bikes/%s/inline-display?field=%s", bikeId, field) }
			hx-target="closest form"
			hx-swap="outerHTML"
			class="px-1.5 py-0.5 rounded bg-slate-800 text-slate-300 text-xs hover:bg-slate-700"
			title="Cancel"
		>
			✕
		</button>
	</form>
}
