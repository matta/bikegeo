package templates

import (
	"encoding/json"
	"fmt"

	"bikegeo/pkg/model"
)

func findIssue(report *model.ValidationReport, field string) *model.ValidationIssue {
	if report == nil {
		return nil
	}
	for _, issue := range report.Issues {
		if issue.Field == field {
			iss := issue
			return &iss
		}
	}
	return nil
}

func bikeToJson(b model.BikeGeometry) string {
	bytes, err := json.MarshalIndent(b, "", "  ")
	if err != nil {
		return "{}"
	}
	return string(bytes)
}

templ EditorModal(
	bike model.BikeGeometry,
	isNew bool,
	report *model.ValidationReport,
	serverError string,
	viewMode string,
) {
	<div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm overflow-y-auto">
		<div class="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-3xl max-h-[90vh] flex flex-col shadow-2xl">
			<!-- Header -->
			<div class="flex items-center justify-between p-5 border-b border-slate-800">
				<div>
					<h3 class="text-lg font-bold text-white">
						if isNew {
							Add New Bike Geometry
						} else {
							{ fmt.Sprintf("Edit: %s %s", bike.Manufacturer, bike.Model) }
						}
					</h3>
					<p class="text-xs text-slate-400">
						Persists directly as a local JSON file in <code class="text-amber-400 font-mono">data/bikes/*.json</code>
					</p>
				</div>

				<div class="flex items-center gap-3">
					<button
						type="button"
						hx-get={ fmt.Sprintf("/bikes/modal-toggle-view?is_new=%t&mode=%s", isNew, map[bool]string{true: "json", false: "form"}[viewMode != "json"]) }
						hx-target="#modal-container"
						hx-include="#bike-editor-form"
						class="px-2.5 py-1 text-xs rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 flex items-center gap-1.5 transition cursor-pointer"
					>
						if viewMode == "json" {
							<span>Form View</span>
						} else {
							<span>Raw JSON</span>
						}
					</button>

					<button
						type="button"
						onclick="document.getElementById('modal-container').innerHTML = ''"
						class="text-slate-400 hover:text-white p-1 rounded-lg hover:bg-slate-800 transition cursor-pointer"
					>
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
						</svg>
					</button>
				</div>
			</div>

			<!-- Live Validation Pill Bar -->
			if report != nil {
				<div class="bg-slate-950 px-5 py-2.5 border-b border-slate-800 flex flex-wrap items-center justify-between gap-3 text-xs">
					<div class="flex items-center gap-2 font-mono">
						<span class="text-slate-400 font-sans">Live Proof:</span>
						<span class="text-cyan-400">Geometric A2C = { fmt.Sprintf("%.1f mm", report.GeometricA2c) }</span>
						if report.A2cDifference != nil {
							<span class="text-slate-400 font-mono">
								(Δ { fmt.Sprintf("%+.1f mm", *report.A2cDifference) } vs stated)
							</span>
						}
					</div>

					<div>
						if report.IsValid {
							<span class="text-emerald-400 font-medium flex items-center gap-1">
								<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
								Internally Coherent
							</span>
						} else {
							<span class="text-rose-400 font-medium flex items-center gap-1">
								<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
								{ fmt.Sprintf("%d issue(s) detected", len(report.Issues)) }
							</span>
						}
					</div>
				</div>
			}

			if serverError != "" {
				<div class="bg-rose-500/10 border-b border-rose-500/20 px-5 py-2.5 text-xs text-rose-300">
					{ serverError }
				</div>
			}

			<!-- Target Pattern 3: Asynchronous form submission with loading indicator via hx-indicator and inline validation errors -->
			<form
				id="bike-editor-form"
				hx-post={ fmt.Sprintf("/bikes/save?is_new=%t", isNew) }
				hx-target="#modal-container"
				hx-indicator="#save-indicator"
				class="flex-1 overflow-y-auto p-5 space-y-5"
			>
				<input type="hidden" name="id" value={ bike.ID }/>

				if viewMode == "json" {
					<div>
						<label class="block text-xs font-medium text-slate-300 mb-2">Raw JSON Document</label>
						<textarea
							name="raw_json"
							rows="18"
							class="w-full bg-slate-950 border border-slate-800 rounded-lg p-3 font-mono text-xs text-slate-200 focus:outline-none focus:border-amber-500"
						>
							{ bikeToJson(bike) }
						</textarea>
					</div>
				} else {
					<!-- Frame Identity -->
					<div>
						<h4 class="text-xs font-semibold uppercase tracking-wider text-amber-400 mb-2.5">
							Frame Identity
						</h4>
						<div class="grid grid-cols-1 sm:grid-cols-4 gap-3">
							<div>
								<label class="block text-xs text-slate-300 mb-1">Manufacturer *</label>
								<input
									type="text"
									name="manufacturer"
									required
									value={ bike.Manufacturer }
									placeholder="e.g. Santa Cruz"
									class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-1.5 text-xs text-white focus:border-amber-500"
								/>
								if issue := findIssue(report, "manufacturer"); issue != nil {
									<div class="text-[11px] text-rose-400 mt-1 font-medium">{ issue.Title }: { issue.Message }</div>
								}
							</div>
							<div>
								<label class="block text-xs text-slate-300 mb-1">Model *</label>
								<input
									type="text"
									name="model"
									required
									value={ bike.Model }
									placeholder="e.g. Chameleon 29"
									class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-1.5 text-xs text-white focus:border-amber-500"
								/>
								if issue := findIssue(report, "model"); issue != nil {
									<div class="text-[11px] text-rose-400 mt-1 font-medium">{ issue.Title }: { issue.Message }</div>
								}
							</div>
							<div>
								<label class="block text-xs text-slate-300 mb-1">Size *</label>
								<input
									type="text"
									name="size"
									required
									value={ bike.Size }
									placeholder="e.g. M, L, XL"
									class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-1.5 text-xs text-white focus:border-amber-500"
								/>
								if issue := findIssue(report, "size"); issue != nil {
									<div class="text-[11px] text-rose-400 mt-1 font-medium">{ issue.Title }: { issue.Message }</div>
								}
							</div>
							<div>
								<label class="block text-xs text-slate-300 mb-1">Category</label>
								<select
									name="category"
									class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-1.5 text-xs text-white focus:border-amber-500"
								>
									<option value="hardtail" selected?={ bike.Category == model.CategoryHardtail }>Hardtail</option>
									<option value="full-suspension" selected?={ bike.Category == model.CategoryFullSuspension }>Full Suspension</option>
									<option value="gravel" selected?={ bike.Category == model.CategoryGravel }>Gravel</option>
									<option value="rigid" selected?={ bike.Category == model.CategoryRigid }>Rigid</option>
								</select>
							</div>
						</div>
					</div>

					<!-- Primary Dimensions -->
					<div>
						<h4 class="text-xs font-semibold uppercase tracking-wider text-cyan-400 mb-2.5">
							Primary Frame Geometry
						</h4>
						<div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
							<!-- Reach -->
							<div>
								<label class="block text-xs text-slate-300 mb-1">Reach (mm) *</label>
								<input
									type="number"
									step="any"
									name="reach"
									required
									value={ fmt.Sprintf("%.1f", bike.Reach) }
									class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-1.5 text-xs text-white font-mono focus:border-amber-500"
								/>
								if issue := findIssue(report, "reach"); issue != nil {
									<div class="text-[11px] text-rose-400 mt-1 font-medium">{ issue.Message }</div>
								}
							</div>

							<!-- Stack -->
							<div>
								<label class="block text-xs text-slate-300 mb-1">Stack (mm) *</label>
								<input
									type="number"
									step="any"
									name="stack"
									required
									value={ fmt.Sprintf("%.1f", bike.Stack) }
									class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-1.5 text-xs text-white font-mono focus:border-amber-500"
								/>
								if issue := findIssue(report, "stack"); issue != nil {
									<div class="text-[11px] text-rose-400 mt-1 font-medium">{ issue.Message }</div>
								}
							</div>

							<!-- HTA -->
							<div>
								<label class="block text-xs text-slate-300 mb-1">Head Tube Angle (°) *</label>
								<input
									type="number"
									step="any"
									name="hta_deg"
									required
									value={ fmt.Sprintf("%.2f", bike.HtaDeg) }
									class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-1.5 text-xs text-white font-mono focus:border-amber-500"
								/>
								if issue := findIssue(report, "hta_deg"); issue != nil {
									<div class="text-[11px] text-rose-400 mt-1 font-medium">{ issue.Message }</div>
								}
							</div>

							<!-- STA -->
							<div>
								<label class="block text-xs text-slate-300 mb-1">Seat Tube Angle (°) *</label>
								<input
									type="number"
									step="any"
									name="sta_deg"
									required
									value={ fmt.Sprintf("%.2f", bike.StaDeg) }
									class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-1.5 text-xs text-white font-mono focus:border-amber-500"
								/>
								if issue := findIssue(report, "sta_deg"); issue != nil {
									<div class="text-[11px] text-rose-400 mt-1 font-medium">{ issue.Message }</div>
								}
							</div>

							<!-- HTL -->
							<div>
								<label class="block text-xs text-slate-300 mb-1">Head Tube Length (mm) *</label>
								<input
									type="number"
									step="any"
									name="htl"
									required
									value={ fmt.Sprintf("%.1f", bike.Htl) }
									class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-1.5 text-xs text-white font-mono focus:border-amber-500"
								/>
								if issue := findIssue(report, "htl"); issue != nil {
									<div class="text-[11px] text-rose-400 mt-1 font-medium">{ issue.Message }</div>
								}
							</div>

							<!-- BB Drop -->
							<div>
								<label class="block text-xs text-slate-300 mb-1">BB Drop (mm) *</label>
								<input
									type="number"
									step="any"
									name="bb_drop"
									required
									value={ fmt.Sprintf("%.1f", bike.BbDrop) }
									class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-1.5 text-xs text-white font-mono focus:border-amber-500"
								/>
								if issue := findIssue(report, "bb_drop"); issue != nil {
									<div class="text-[11px] text-rose-400 mt-1 font-medium">{ issue.Message }</div>
								}
							</div>

							<!-- Fork Rake -->
							<div>
								<label class="block text-xs text-slate-300 mb-1">Fork Rake / Offset (mm) *</label>
								<input
									type="number"
									step="any"
									name="fork_rake"
									required
									value={ fmt.Sprintf("%.1f", bike.ForkRake) }
									class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-1.5 text-xs text-white font-mono focus:border-amber-500"
								/>
								if issue := findIssue(report, "fork_rake"); issue != nil {
									<div class="text-[11px] text-rose-400 mt-1 font-medium">{ issue.Message }</div>
								}
							</div>

							<!-- Wheelbase -->
							<div>
								<label class="block text-xs text-slate-300 mb-1">Wheelbase (mm) *</label>
								<input
									type="number"
									step="any"
									name="wheelbase"
									required
									value={ fmt.Sprintf("%.1f", bike.Wheelbase) }
									class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-1.5 text-xs text-white font-mono focus:border-amber-500"
								/>
								if issue := findIssue(report, "wheelbase"); issue != nil {
									<div class="text-[11px] text-rose-400 mt-1 font-medium">{ issue.Message }</div>
								}
							</div>
						</div>
					</div>

					<!-- Hardware & CAD Specifications -->
					<div>
						<h4 class="text-xs font-semibold uppercase tracking-wider text-indigo-400 mb-2.5">
							Hardware & CAD Assumptions
						</h4>
						<div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
							<!-- Stated Fork A2C -->
							<div>
								<label class="block text-xs text-slate-300 mb-1">Published Fork A2C (mm)</label>
								<input
									type="number"
									step="any"
									name="fork_a2c"
									value={ fmt.Sprintf("%.1f", bike.ForkA2c) }
									placeholder="e.g. 541"
									class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-1.5 text-xs text-white font-mono focus:border-amber-500"
								/>
								if issue := findIssue(report, "fork_a2c"); issue != nil {
									<div class="text-[11px] text-rose-400 mt-1 font-medium">{ issue.Message }</div>
								}
							</div>

							<!-- Fork Travel -->
							<div>
								<label class="block text-xs text-slate-300 mb-1">Fork Travel (mm)</label>
								<input
									type="number"
									step="any"
									name="fork_travel_mm"
									value={ fmt.Sprintf("%.0f", bike.ForkTravelMm) }
									placeholder="e.g. 130"
									class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-1.5 text-xs text-white font-mono focus:border-amber-500"
								/>
							</div>

							<!-- Headset Cup Type -->
							<div>
								<label class="block text-xs text-slate-300 mb-1">Headset Cup Standard</label>
								<select
									name="headset_cup_type"
									class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-1.5 text-xs text-white focus:border-amber-500 font-mono"
								>
									<option value="ZS44" selected?={ bike.HeadsetCupType == model.CupZS44 }>ZS44 (Zero Stack)</option>
									<option value="EC44" selected?={ bike.HeadsetCupType == model.CupEC44 }>EC44 (External +12mm)</option>
									<option value="ZS56" selected?={ bike.HeadsetCupType == model.CupZS56 }>ZS56</option>
									<option value="IS52" selected?={ bike.HeadsetCupType == model.CupIS52 }>IS52 (Integrated)</option>
								</select>
								if issue := findIssue(report, "cup_stack"); issue != nil {
									<div class="text-[11px] text-amber-400 mt-1 font-medium">{ issue.Message }</div>
								}
							</div>

							<!-- Lower Cup Stack -->
							<div>
								<label class="block text-xs text-slate-300 mb-1">Lower Cup Stack (mm)</label>
								<input
									type="number"
									step="any"
									name="cup_stack"
									value={ fmt.Sprintf("%.1f", bike.CupStack) }
									placeholder="12 for EC44, 2 for ZS"
									class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-1.5 text-xs text-white font-mono focus:border-amber-500"
								/>
							</div>
						</div>
					</div>

					<!-- Notes -->
					<div>
						<label class="block text-xs text-slate-300 mb-1">Notes / Description</label>
						<textarea
							name="notes"
							rows="2"
							placeholder="Hardware configuration, rider notes, OEM fork details..."
							class="w-full bg-slate-950 border border-slate-800 rounded-lg p-2.5 text-xs text-white focus:border-amber-500"
						>
							{ bike.Notes }
						</textarea>
					</div>
				}

				<!-- Footer with Save & Loading Indicator (Target Pattern 3) -->
				<div class="flex items-center justify-between pt-4 border-t border-slate-800">
					<!-- Loading Indicator via hx-indicator -->
					<div id="save-indicator" class="htmx-indicator flex items-center gap-2 text-xs font-semibold text-amber-400">
						<svg class="animate-spin w-4 h-4 text-amber-400" fill="none" viewBox="0 0 24 24">
							<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
							<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
						</svg>
						<span>Saving & validating frame geometry...</span>
					</div>

					<div class="flex items-center gap-3 ml-auto">
						<button
							type="button"
							onclick="document.getElementById('modal-container').innerHTML = ''"
							class="px-4 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-medium cursor-pointer"
						>
							Cancel
						</button>
						<button
							type="submit"
							class="px-4 py-2 rounded-lg bg-amber-500 hover:bg-amber-400 text-slate-950 text-xs font-bold shadow-lg shadow-amber-500/20 cursor-pointer flex items-center gap-1.5"
						>
							<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"></path>
							</svg>
							<span>Save Geometry</span>
						</button>
					</div>
				</div>
			</form>
		</div>
	</div>
}
