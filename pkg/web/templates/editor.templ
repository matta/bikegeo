											/>
										</td>
									}
									<td class="p-1.5 text-center"></td>
								</tr>

								<!-- Stack -->
								<tr class="hover:bg-slate-900/50">
									<td class="p-2 font-medium text-amber-300 sticky left-0 bg-slate-950 z-10 border-r border-slate-800">
										<div>Stack (mm) *</div>
									</td>
									for _, sz := range sizes {
										{{ geo := activeConfig.Geometries[sz] }}
										<td class="p-1.5 border-r border-slate-800/80">
