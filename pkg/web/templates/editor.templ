									<td class="p-2 font-medium text-slate-300 sticky left-0 bg-slate-950 z-10 border-r border-slate-800">
										<div>BB Drop (mm) *</div>
									</td>
									for _, sz := range sizes {
										{{ geo := activeConfig.Geometries[sz] }}
										<td class="p-1.5 border-r border-slate-800/80">
											<input
												type="number"
												step="any"
												required
												name={ "bb_drop_" + sz }
												value={ fmt.Sprintf("%.1f", geo.BbDrop) }
												placeholder="mm"
												class="w-full bg-slate-900 border border-slate-800 rounded px-2 py-1 text-center font-mono text-white text-xs focus:border-amber-500"
											/>
										</td>
									}
									<td class="p-1.5 text-center">
										<button
											type="button"
											onclick="copyRowToAll('bb_drop')"
											class="px-2 py-0.5 rounded bg-slate-800 hover:bg-slate-700 text-amber-400 text-[10px] border border-slate-700 cursor-pointer"
											title="Copy value across all sizes"
										>
											[-> All]
										</button>
									</td>
								</tr>

								<!-- Wheelbase -->
								<tr class="hover:bg-slate-900/50">
									<td class="p-2 font-medium text-slate-300 sticky left-0 bg-slate-950 z-10 border-r border-slate-800">
										<div>Wheelbase (mm)</div>
									</td>
									for _, sz := range sizes {
										{{ geo := activeConfig.Geometries[sz] }}
										<td class="p-1.5 border-r border-slate-800/80">
											<input
												type="number"
												step="any"
												name={ "wheelbase_" + sz }
												value={ fmt.Sprintf("%.1f", geo.Wheelbase) }
												placeholder="mm"
												class="w-full bg-slate-900 border border-slate-800 rounded px-2 py-1 text-center font-mono text-white text-xs focus:border-amber-500"
											/>
										</td>
									}
									<td class="p-1.5 text-center"></td>
								</tr>

								<!-- Chainstay Length -->
								<tr class="hover:bg-slate-900/50">
									<td class="p-2 font-medium text-slate-300 sticky left-0 bg-slate-950 z-10 border-r border-slate-800">
										<div>Chainstay Length (mm)</div>
									</td>
									for _, sz := range sizes {
										{{ geo := activeConfig.Geometries[sz] }}
										<td class="p-1.5 border-r border-slate-800/80">
											<input
												type="number"
												step="any"
												name={ "chainstay_length_" + sz }
												value={ fmt.Sprintf("%.1f", geo.ChainstayLength) }
												placeholder="mm"
												class="w-full bg-slate-900 border border-slate-800 rounded px-2 py-1 text-center font-mono text-white text-xs focus:border-amber-500"
											/>
										</td>
									}
									<td class="p-1.5 text-center">
										<button
											type="button"
											onclick="copyRowToAll('chainstay_length')"
											class="px-2 py-0.5 rounded bg-slate-800 hover:bg-slate-700 text-amber-400 text-[10px] border border-slate-700 cursor-pointer"
											title="Copy value across all sizes"
										>
											[-> All]
										</button>
									</td>
								</tr>

								<!-- Seat Tube Length -->
								<tr class="hover:bg-slate-900/50">
									<td class="p-2 font-medium text-slate-300 sticky left-0 bg-slate-950 z-10 border-r border-slate-800">
										<div>Seat Tube Length (mm)</div>
									</td>
									for _, sz := range sizes {
										{{ geo := activeConfig.Geometries[sz] }}
										<td class="p-1.5 border-r border-slate-800/80">
											<input
												type="number"
												step="any"
												name={ "seat_tube_length_" + sz }
												value={ fmt.Sprintf("%.1f", geo.SeatTubeLength) }
												placeholder="mm"
												class="w-full bg-slate-900 border border-slate-800 rounded px-2 py-1 text-center font-mono text-white text-xs focus:border-amber-500"
											/>
										</td>
									}
									<td class="p-1.5 text-center"></td>
								</tr>
							</tbody>
						</table>
					</div>
				</div>
			}

			<!-- Action Card with Save & Loading Indicator -->
			<div class="bg-slate-900 border border-slate-800 rounded-xl p-4 shadow-md flex items-center justify-between">
				<!-- Loading Indicator via hx-indicator -->
				<div id="save-indicator" class="htmx-indicator flex items-center gap-2 text-xs font-semibold text-amber-400">
					<svg class="animate-spin w-4 h-4 text-amber-400" fill="none" viewBox="0 0 24 24">
						<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
						<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
					</svg>
					<span>Saving & validating frame geometry table...</span>
				</div>

				<div class="flex items-center gap-3 ml-auto">
					<button
						type="button"
						hx-get={ cancelUrl }
						hx-target="#app-content"
						hx-push-url="true"
						class="px-4 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-medium cursor-pointer"
					>
						Cancel
					</button>
					<button
						type="submit"
						class="px-5 py-2 rounded-lg bg-amber-500 hover:bg-amber-400 text-slate-950 text-xs font-bold shadow-lg shadow-amber-500/20 cursor-pointer flex items-center gap-1.5 transition"
					>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"></path>
						</svg>
						<span>Save Frame Model</span>
					</button>
				</div>
			</div>
		</form>
	</div>

	<script>
		function handleForkPresetChange(select) {
			const opt = select.options[select.selectedIndex];
			if (!opt || !opt.value) return;
			const a2c = opt.getAttribute('data-a2c');
			const travel = opt.getAttribute('data-travel');
			const rake = opt.getAttribute('data-rake');
			if (a2c) {
				const a2cInput = document.getElementById('active_fork_a2c');
				if (a2cInput) a2cInput.value = a2c;
			}
			if (travel) {
				const travelInput = document.getElementById('active_fork_travel_mm');
				if (travelInput) travelInput.value = travel;
			}
			if (rake) {
				const rakeInput = document.getElementById('active_fork_rake');
				if (rakeInput) rakeInput.value = rake;
			}
		}

		function copyRowToAll(prefix) {
			const inputs = document.querySelectorAll(`input[name^="${prefix}_"]`);
			let val = null;
			inputs.forEach(inp => {
				if (val === null && inp.value && parseFloat(inp.value) > 0) {
					val = inp.value;
				}
			});
			if (val !== null) {
				inputs.forEach(inp => {
					inp.value = val;
				});
			}
		}
	</script>
}
