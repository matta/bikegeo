package templates

import (
	"encoding/json"
	"fmt"

	"bikegeo/pkg/canonicalizer"
	"bikegeo/pkg/model"
)

func findIssue(report *model.ValidationReport, field string) *model.ValidationIssue {
	if report == nil {
		return nil
	}
	for _, issue := range report.Issues {
		if issue.Field == field {
			iss := issue
			return &iss
		}
	}
	return nil
}

func frameToJson(f model.FrameModel) string {
	bytes, err := json.MarshalIndent(f, "", "  ")
	if err != nil {
		return "{}"
	}
	return string(bytes)
}

templ FrameEditorView(
	frame model.FrameModel,
	isNew bool,
	report *model.ValidationReport,
	serverError string,
	viewMode string,
	activeConfigID string,
) {
	{{
		sizes := frame.GetSizes()
		activeConfig := frame.GetConfiguration(activeConfigID)
		if activeConfig == nil {
			activeConfig = frame.GetBaselineConfiguration()
		}
		if activeConfig == nil {
			activeConfig = &model.FrameConfiguration{
				ID:         "stock",
				Name:       "Stock Build",
				IsBaseline: true,
				Fork:       model.ForkSpec{ID: "fox34_130", Name: "Fox Float 34 130mm", TravelMm: 130, A2c: 541, Rake: 44},
			}
		}
		cancelUrl := "/?tab=validator"
		if frame.ID != "" && !isNew {
			cancelUrl = fmt.Sprintf("/?tab=validator&id=%s", frame.ID)
		}
	}}
	<div id="frame-editor-view" class="space-y-6">
		<!-- Top Navigation & Header Card -->
		<div class="bg-slate-900 border border-slate-800 rounded-xl p-5 shadow-lg flex flex-wrap items-center justify-between gap-4">
			<div class="flex items-center gap-3">
				<button
					type="button"
					hx-get={ cancelUrl }
					hx-target="#app-content"
					hx-push-url="true"
					class="p-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white transition cursor-pointer flex items-center gap-1.5 text-xs font-semibold"
					title="Return without saving"
				>
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
					<span>Back</span>
				</button>
				<div>
					<h2 class="text-xl font-bold text-white">
						if isNew {
							Add New Bike Model & Geometry Grid
						} else {
							{ fmt.Sprintf("Edit: %s %s", frame.Manufacturer, frame.Model) }
						}
					</h2>
					<p class="text-xs text-slate-400">
						Unified multi-size bicycle frame geometry specification • Persists to <code class="text-amber-400 font-mono">data/bikes/*.json</code>
					</p>
				</div>
			</div>

			<div class="flex items-center gap-2">
				<button
					type="button"
					hx-get={ fmt.Sprintf("/bikes/editor/toggle-view?is_new=%t&mode=%s", isNew, map[bool]string{true: "json", false: "form"}[viewMode != "json"]) }
					hx-target="#app-content"
					hx-include="#bike-editor-form"
					class="px-3 py-1.5 text-xs rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 flex items-center gap-1.5 transition cursor-pointer font-medium"
				>
					if viewMode == "json" {
						<span>Form View</span>
					} else {
						<span>Raw JSON</span>
					}
				</button>

				<button
					type="button"
					hx-get={ cancelUrl }
					hx-target="#app-content"
					hx-push-url="true"
					class="px-3 py-1.5 text-xs rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white border border-slate-700 transition cursor-pointer font-medium"
				>
					Cancel
				</button>
			</div>
		</div>

		<!-- Live Validation Pill Bar -->
		if report != nil {
			<div class="bg-slate-900 border border-slate-800 rounded-xl px-5 py-3 flex flex-wrap items-center justify-between gap-3 text-xs shadow-md">
				<div class="flex items-center gap-2 font-mono">
					<span class="text-slate-400 font-sans">Baseline CAD Proof ({ frame.GetDefaultSize() }):</span>
					<span class="text-cyan-400">Geometric A2C = { fmt.Sprintf("%.1f mm", report.GeometricA2c) }</span>
					if report.A2cDifference != nil {
						<span class="text-slate-400 font-mono">
							(Δ { fmt.Sprintf("%+.1f mm", *report.A2cDifference) } vs stated)
						</span>
					}
				</div>

				<div>
					if report.IsValid {
						<span class="text-emerald-400 font-medium flex items-center gap-1">
							<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
							Frame Spec Coherent
						</span>
					} else {
						<span class="text-rose-400 font-medium flex items-center gap-1">
							<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
							{ fmt.Sprintf("%d issue(s) detected", len(report.Issues)) }
						</span>
					}
				</div>
			</div>
		}

		if serverError != "" {
			<div class="bg-rose-500/10 border border-rose-500/20 rounded-xl px-5 py-3 text-xs text-rose-300 shadow-md">
				{ serverError }
			</div>
		}

		<!-- Async Form -->
		<form
			id="bike-editor-form"
			hx-post={ fmt.Sprintf("/bikes/save?is_new=%t", isNew) }
			hx-target="#app-content"
			hx-indicator="#save-indicator"
			novalidate
			class="space-y-6"
		>
			<input type="hidden" name="id" value={ frame.ID }/>
			<input type="hidden" name="active_config_id" value={ activeConfig.ID }/>

			if viewMode == "json" {
				<div class="bg-slate-900 border border-slate-800 rounded-xl p-5 shadow-md">
					<label class="block text-xs font-medium text-slate-300 mb-2">Raw FrameModel JSON Document</label>
					<textarea
						name="raw_json"
						rows="22"
						class="w-full bg-slate-950 border border-slate-800 rounded-lg p-3 font-mono text-xs text-slate-200 focus:outline-none focus:border-amber-500"
					>
						{ frameToJson(frame) }
					</textarea>
				</div>
			} else {
				<!-- 1. Frame Identity -->
				<div class="bg-slate-900 border border-slate-800 rounded-xl p-5 shadow-md">
					<h4 class="text-xs font-semibold uppercase tracking-wider text-amber-400 mb-3">
						Frame Identity & Hardware
					</h4>
					<div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-6 gap-3.5">
						<div class="sm:col-span-2">
							<label class="block text-xs text-slate-300 mb-1">Manufacturer *</label>
							<input
								type="text"
								name="manufacturer"
								required
								value={ frame.Manufacturer }
								placeholder="e.g. Chumba, Santa Cruz"
								class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-1.5 text-xs text-white focus:border-amber-500"
							/>
							if issue := findIssue(report, "manufacturer"); issue != nil {
								<div class="text-[11px] text-rose-400 mt-1 font-medium">{ issue.Title }</div>
							}
						</div>
						<div class="sm:col-span-2">
							<label class="block text-xs text-slate-300 mb-1">Model *</label>
							<input
								type="text"
								name="model"
								required
								value={ frame.Model }
								placeholder="e.g. Sendero, Chameleon"
								class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-1.5 text-xs text-white focus:border-amber-500"
							/>
							if issue := findIssue(report, "model"); issue != nil {
								<div class="text-[11px] text-rose-400 mt-1 font-medium">{ issue.Title }</div>
							}
						</div>
						<div>
							<label class="block text-xs text-slate-300 mb-1">Year</label>
							<input
								type="number"
								name="year"
								value={ fmt.Sprintf("%d", frame.Year) }
								class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-1.5 text-xs text-white focus:border-amber-500"
							/>
						</div>
						<div>
							<label class="block text-xs text-slate-300 mb-1">Category</label>
							<select
								name="category"
								class="w-full bg-slate-950 border border-slate-800 rounded-lg px-2.5 py-1.5 text-xs text-white focus:border-amber-500"
							>
								<option value="hardtail" selected?={ frame.Category == model.CategoryHardtail }>Hardtail</option>
								<option value="rigid" selected?={ frame.Category == model.CategoryRigid }>Rigid</option>
								<option value="gravel" selected?={ frame.Category == model.CategoryGravel }>Gravel</option>
								<option value="full-suspension" selected?={ frame.Category == model.CategoryFullSuspension }>Full Suspension</option>
							</select>
						</div>
						<div>
							<label class="block text-xs text-slate-300 mb-1">Wheel Size</label>
							<input
								type="text"
								name="wheel_size"
								value={ frame.WheelSize }
								placeholder="29, 27.5, Mullet"
								class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-1.5 text-xs text-white focus:border-amber-500"
							/>
						</div>
						<div>
							<label class="block text-xs text-slate-300 mb-1">Headset Standard</label>
							<select
								name="headset_cup_type"
								class="w-full bg-slate-950 border border-slate-800 rounded-lg px-2 py-1.5 text-xs text-white font-mono focus:border-amber-500"
							>
								<option value="EC44" selected?={ frame.HeadsetCupType == model.CupEC44 }>EC44 (External +12mm)</option>
								<option value="ZS44" selected?={ frame.HeadsetCupType == model.CupZS44 }>ZS44 (Zero Stack)</option>
								<option value="IS52" selected?={ frame.HeadsetCupType == model.CupIS52 }>IS52 (Integrated)</option>
								<option value="ZS56" selected?={ frame.HeadsetCupType == model.CupZS56 }>ZS56</option>
							</select>
						</div>
						<div>
							<label class="block text-xs text-slate-300 mb-1">Lower Cup Stack (mm)</label>
							<input
								type="number"
								step="any"
								name="cup_stack"
								value={ fmt.Sprintf("%.1f", frame.CupStack) }
								placeholder="12 for EC44, 2 for ZS"
								class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-1.5 text-xs text-white font-mono focus:border-amber-500"
							/>
						</div>
						<div class="sm:col-span-3">
							<label class="block text-xs text-slate-300 mb-1">Frame Notes</label>
							<input
								type="text"
								name="notes"
								value={ frame.Notes }
								placeholder="Dropouts, compatible forks, build options..."
								class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-1.5 text-xs text-white focus:border-amber-500"
							/>
						</div>
					</div>
				</div>

				<!-- 2. Configurations Bar -->
				<div class="bg-slate-900 border border-slate-800 rounded-xl p-5 space-y-4 shadow-md">
					<div class="flex flex-wrap items-center justify-between gap-2">
						<div class="flex items-center gap-2">
							<span class="text-xs font-semibold uppercase tracking-wider text-indigo-400">
								Configurations:
							</span>
							<div class="flex flex-wrap items-center gap-1.5">
								for _, cfg := range frame.Configurations {
									{{ isActive := cfg.ID == activeConfig.ID }}
									<button
										type="button"
										hx-post={ fmt.Sprintf("/bikes/editor/action?act=switch-config&config_id=%s", cfg.ID) }
										hx-target="#app-content"
										hx-include="#bike-editor-form"
										class={ "px-2.5 py-1 rounded text-xs transition cursor-pointer flex items-center gap-1 border",
											templ.KV("bg-amber-500 text-slate-950 font-bold border-amber-400 shadow-sm", isActive),
											templ.KV("bg-slate-900 text-slate-300 border-slate-800 hover:bg-slate-800", !isActive) }
									>
										<span>{ cfg.Name }</span>
										if cfg.IsBaseline {
											<span class="text-[10px] uppercase font-mono px-1 py-0.2 rounded bg-black/30 text-slate-200">Ref</span>
										}
									</button>
								}
							</div>
						</div>

						<button
							type="button"
							hx-post="/bikes/editor/action?act=add-config"
							hx-target="#app-content"
							hx-include="#bike-editor-form"
							class="px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-amber-400 text-xs border border-slate-700 flex items-center gap-1 transition cursor-pointer"
						>
							<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
							<span>+ Add Config</span>
						</button>
					</div>

					<!-- Active Configuration Specs -->
					<div class="grid grid-cols-2 sm:grid-cols-6 gap-3.5 pt-2 border-t border-slate-800/50">
						<div class="col-span-2">
							<label class="block text-[11px] text-slate-400 mb-1">Config Name</label>
							<input
								type="text"
								name="active_config_name"
								value={ activeConfig.Name }
								class="w-full bg-slate-950 border border-slate-800 rounded px-2.5 py-1 text-xs text-white"
							/>
						</div>
						<div class="col-span-2">
							<div class="flex items-center justify-between mb-1">
								<label class="block text-[11px] text-slate-400">Fork Preset</label>
								if activeConfig.Fork.IsInferred || activeConfig.Fork.ID != "" {
									<span class="px-1.5 py-0.2 rounded text-[9px] font-medium bg-amber-950/60 text-amber-300 border border-amber-800/40" title="Values inferred from registry entry">
										Inferred
									</span>
								}
							</div>
							<select
								name="active_fork_preset"
								id="active_fork_preset"
								onchange="handleForkPresetChange(this)"
								class="w-full bg-slate-950 border border-slate-800 rounded px-2 py-1 text-xs text-amber-400 font-mono"
							>
								<option value="">-- Custom Fork Spec --</option>
								for _, opt := range canonicalizer.DefaultForkPresets {
									<option
										value={ opt.ID }
										data-a2c={ fmt.Sprintf("%.1f", opt.StaticA2c) }
										data-travel={ fmt.Sprintf("%.1f", opt.TravelMm) }
										data-rake={ fmt.Sprintf("%.1f", opt.Rake) }
										selected?={ opt.ID == activeConfig.Fork.ID || (opt.TravelMm == activeConfig.Fork.TravelMm && opt.StaticA2c == activeConfig.Fork.A2c && opt.Rake == activeConfig.Fork.Rake) }
									>
										{ opt.Name } (A2C: { fmt.Sprintf("%.0f", opt.StaticA2c) }mm)
									</option>
								}
							</select>
						</div>
						<div>
							<label class="block text-[11px] text-slate-400 mb-1">Fork Travel (mm) *</label>
							<input
								type="number"
								step="any"
								name="active_fork_travel_mm"
								id="active_fork_travel_mm"
								value={ fmt.Sprintf("%.1f", activeConfig.Fork.TravelMm) }
								class="w-full bg-slate-950 border border-slate-800 rounded px-2 py-1 text-xs text-white font-mono"
							/>
						</div>
						<div>
							<label class="block text-[11px] text-slate-400 mb-1">Fork A2C (mm) *</label>
							<input
								type="number"
								step="any"
								name="active_fork_a2c"
								id="active_fork_a2c"
								value={ fmt.Sprintf("%.1f", activeConfig.Fork.A2c) }
								class="w-full bg-slate-950 border border-slate-800 rounded px-2 py-1 text-xs text-white font-mono"
							/>
						</div>
						<div>
							<label class="block text-[11px] text-slate-400 mb-1">Fork Rake/Offset (mm) *</label>
							<input
								type="number"
								step="any"
								name="active_fork_rake"
								id="active_fork_rake"
								value={ fmt.Sprintf("%.1f", activeConfig.Fork.Rake) }
								class="w-full bg-slate-950 border border-slate-800 rounded px-2 py-1 text-xs text-white font-mono"
							/>
						</div>
					</div>

					if !activeConfig.IsBaseline {
						<div class="flex items-center justify-between bg-indigo-950/30 border border-indigo-800/30 rounded-lg px-3 py-2 text-xs text-indigo-300">
							<span>Alternative Configuration: Enter published values below or derive dynamically from baseline.</span>
							<button
								type="button"
								hx-post="/bikes/editor/action?act=kinematic-fill"
								hx-target="#app-content"
								hx-include="#bike-editor-form"
								class="px-2.5 py-1 rounded bg-indigo-600 hover:bg-indigo-500 text-white font-medium text-[11px] cursor-pointer flex items-center gap-1 shadow-sm transition"
							>
								<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
								<span>Kinematic Auto-Fill</span>
							</button>
						</div>
					}
				</div>

				<!-- 3. Dynamic Sizes & Multi-Size Geometry Grid -->
				<div class="bg-slate-900 border border-slate-800 rounded-xl p-5 shadow-md">
					<div class="flex flex-wrap items-center justify-between gap-3 mb-3">
						<div class="flex items-center gap-2">
							<h4 class="text-xs font-semibold uppercase tracking-wider text-cyan-400">
								Geometry Chart Grid ({ activeConfig.Name })
							</h4>
							<span class="text-xs text-slate-400">
								{ fmt.Sprintf("(%d Sizes Defined)", len(sizes)) }
							</span>
						</div>

						<div class="flex items-center gap-2">
							<span class="text-[11px] text-slate-400">Quick Sizing Presets:</span>
							<button
								type="button"
								hx-post="/bikes/editor/action?act=preset&preset_type=s_xl"
								hx-target="#app-content"
								hx-include="#bike-editor-form"
								class="px-2 py-0.5 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 text-[11px] border border-slate-700 cursor-pointer"
							>
								S, M, L, XL
							</button>
							<button
								type="button"
								hx-post="/bikes/editor/action?act=preset&preset_type=s1_s6"
								hx-target="#app-content"
								hx-include="#bike-editor-form"
								class="px-2 py-0.5 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 text-[11px] border border-slate-700 cursor-pointer"
							>
								S1–S6
							</button>
							<button
								type="button"
								hx-post="/bikes/editor/action?act=preset&preset_type=cm"
								hx-target="#app-content"
								hx-include="#bike-editor-form"
								class="px-2 py-0.5 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 text-[11px] border border-slate-700 cursor-pointer"
							>
								49–61cm
							</button>
							<button
								type="button"
								hx-post="/bikes/editor/action?act=add-size"
								hx-target="#app-content"
								hx-include="#bike-editor-form"
								class="px-2.5 py-1 rounded bg-cyan-500/20 text-cyan-300 hover:bg-cyan-500/30 text-xs font-medium border border-cyan-500/40 cursor-pointer flex items-center gap-1"
							>
								<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
								<span>+ Add Size</span>
							</button>
						</div>
					</div>

					<!-- Geometry Table -->
					<div class="overflow-x-auto border border-slate-800 rounded-xl bg-slate-950/60 shadow-inner">
						<table class="w-full text-left text-xs border-collapse">
							<thead>
								<tr class="bg-slate-950 border-b border-slate-800 text-slate-300">
									<th class="p-2.5 font-semibold w-48 sticky left-0 bg-slate-950 z-10 border-r border-slate-800">
										Frame Dimension
									</th>
									for _, sz := range sizes {
										<th class="p-2.5 text-center min-w-[120px] border-r border-slate-800/80">
											<div class="flex items-center justify-center gap-1.5">
												<input
													type="text"
													name="sizes"
													value={ sz }
													class="w-16 bg-slate-900 border border-slate-700 rounded px-1.5 py-0.5 text-center font-bold text-amber-300 text-xs focus:border-amber-500"
												/>
												if len(sizes) > 1 {
													<button
														type="button"
														hx-post={ fmt.Sprintf("/bikes/editor/action?act=remove-size&size=%s", sz) }
														hx-target="#app-content"
														hx-include="#bike-editor-form"
														class="text-rose-400 hover:text-rose-300 text-xs cursor-pointer px-1 py-0.5 rounded hover:bg-slate-800"
														title="Remove Size Column"
													>
														×
													</button>
												}
											</div>
										</th>
									}
									<th class="p-2.5 text-center w-28 text-slate-400">
										Copy Helpers
									</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-slate-800/60">
								<!-- Reach -->
								<tr class="hover:bg-slate-900/50">
									<td class="p-2 font-medium text-cyan-300 sticky left-0 bg-slate-950 z-10 border-r border-slate-800">
										<div>Reach (mm) *</div>
									</td>
									for _, sz := range sizes {
										{{ geo := activeConfig.Geometries[sz] }}
										<td class="p-1.5 border-r border-slate-800/80">
											<input
												type="number"
												step="any"
												required
