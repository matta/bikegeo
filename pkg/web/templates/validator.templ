package templates

import (
	"fmt"

	"bikegeo/pkg/model"
)

func isWithinStaticTolerance(diff *float64) bool {
	return diff != nil && *diff >= -6.0 && *diff <= 6.0
}

func isWithinSaggedRange(diff *float64) bool {
	return diff != nil && *diff >= 15.0 && *diff <= 38.0
}

func isMismatched(diff *float64) bool {
	if diff == nil {
		return false
	}
	return !isWithinStaticTolerance(diff) && !isWithinSaggedRange(diff)
}

templ ValidatorSidebar(bikes []model.BikeGeometry, inspectedBikeId string, report model.ValidationReport) {
	<div class="lg:col-span-1 space-y-3">
		<div class="flex items-center justify-between px-1">
			<span class="text-xs font-semibold uppercase tracking-wider text-slate-400">
				{ fmt.Sprintf("Local Frame Models (%d)", len(bikes)) }
			</span>
			<button
				type="button"
				hx-get="/bikes/new"
				hx-target="#modal-container"
				class="text-xs text-amber-400 hover:underline flex items-center gap-1 cursor-pointer"
			>
				<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
				</svg>
				<span>New</span>
			</button>
		</div>

		<div class="space-y-2">
			for _, b := range bikes {
				{{
					isInspected := b.ID == inspectedBikeId
				}}
				<div
					hx-get={ fmt.Sprintf("/?tab=validator&id=%s", b.ID) }
					hx-target="#app-content"
					class={ "p-3 rounded-xl border cursor-pointer transition flex flex-col justify-between",
						templ.KV("bg-slate-900 border-amber-500/50 shadow-md ring-1 ring-amber-500/30", isInspected),
						templ.KV("bg-slate-900/60 border-slate-800/80 hover:bg-slate-900 hover:border-slate-700", !isInspected) }
				>
					<div class="flex items-start justify-between">
						<div>
							<div class="font-bold text-white text-sm">
								{ b.Manufacturer } { b.Model }
							</div>
							<div class="text-xs text-slate-400 mt-0.5">
								{ fmt.Sprintf("Size %s • %s", b.Size, b.Category) }
							</div>
						</div>

						<div class="flex items-center gap-1.5">
							if b.ID == inspectedBikeId && !report.IsValid {
								<svg class="w-4 h-4 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
								</svg>
							} else {
								<svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
								</svg>
							}
						</div>
					</div>

					<div class="flex items-center justify-between mt-3 pt-2 border-t border-slate-800/60 text-[11px] text-slate-400">
						<div>
							R: <span class="text-cyan-400 font-mono font-semibold">{ fmt.Sprintf("%.0f", b.Reach) }</span>
							S: <span class="text-amber-400 font-mono font-semibold">{ fmt.Sprintf("%.0f", b.Stack) }</span>
						</div>

						<div class="flex items-center gap-2" onclick="event.stopPropagation()">
							<button
								type="button"
								hx-get={ fmt.Sprintf("/bikes/%s/edit", b.ID) }
								hx-target="#modal-container"
								class="hover:text-amber-400 transition cursor-pointer"
								title="Edit bike parameters"
							>
								<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path>
								</svg>
							</button>
							<button
								type="button"
								hx-delete={ fmt.Sprintf("/bikes/%s", b.ID) }
								hx-confirm={ fmt.Sprintf("Are you sure you want to delete %s %s?", b.Manufacturer, b.Model) }
								hx-target="#app-content"
								class="hover:text-rose-400 transition cursor-pointer"
								title="Delete bike"
							>
								<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
								</svg>
							</button>
						</div>
					</div>
				</div>
			}
		</div>
	</div>
}

templ ValidatorHeader(bike model.BikeGeometry, report model.ValidationReport) {
	<div class="bg-slate-900 border border-slate-800 rounded-xl p-5 shadow-lg">
		<div class="flex flex-wrap items-center justify-between gap-4">
			<div>
				<div class="flex items-center gap-3">
					<h2 class="text-2xl font-bold text-white">
						{ bike.Manufacturer } { bike.Model }
					</h2>
					<span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-800 text-slate-300 border border-slate-700">
						Size { bike.Size }
					</span>
					<span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-500/10 text-amber-400 border border-amber-500/20 font-mono uppercase">
						{ string(bike.Category) }
					</span>
				</div>
				<p class="text-sm text-slate-400 mt-1 max-w-2xl">
					if bike.Notes != "" {
						{ bike.Notes }
					} else {
						Bicycle geometry CAD validation and hardtail consistency diagnostics.
					}
				</p>
			</div>

			<div class="flex items-center gap-3">
				if report.IsValid {
					<div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-sm font-medium">
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
						</svg>
						<span>Geometrically Valid</span>
					</div>
				} else {
					<div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-rose-500/10 border border-rose-500/20 text-rose-400 text-sm font-medium">
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
						</svg>
						<span>Validation Errors</span>
					</div>
				}

				<button
					type="button"
					hx-get={ fmt.Sprintf("/bikes/%s/edit", bike.ID) }
					hx-target="#modal-container"
					class="px-3 py-1.5 text-xs font-medium bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 rounded-lg transition cursor-pointer"
				>
					Edit Parameters
				</button>
			</div>
		</div>

		<!-- Quick Spec Pills -->
		<div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-8 gap-3 mt-5 pt-4 border-t border-slate-800 text-center font-mono">
			<div class="bg-slate-950/60 p-2.5 rounded-lg border border-slate-800">
				<span class="text-[11px] text-slate-400 uppercase tracking-wider block font-sans">Reach</span>
				<span class="text-base font-bold text-cyan-400">{ fmt.Sprintf("%.0f", bike.Reach) } <span class="text-xs font-normal text-slate-400 font-sans">mm</span></span>
			</div>
			<div class="bg-slate-950/60 p-2.5 rounded-lg border border-slate-800">
				<span class="text-[11px] text-slate-400 uppercase tracking-wider block font-sans">Stack</span>
				<span class="text-base font-bold text-amber-400">{ fmt.Sprintf("%.0f", bike.Stack) } <span class="text-xs font-normal text-slate-400 font-sans">mm</span></span>
			</div>
			<div class="bg-slate-950/60 p-2.5 rounded-lg border border-slate-800">
				<span class="text-[11px] text-slate-400 uppercase tracking-wider block font-sans">HTA</span>
				<span class="text-base font-bold text-white">{ fmt.Sprintf("%.1f°", bike.HtaDeg) }</span>
			</div>
			<div class="bg-slate-950/60 p-2.5 rounded-lg border border-slate-800">
				<span class="text-[11px] text-slate-400 uppercase tracking-wider block font-sans">STA</span>
				<span class="text-base font-bold text-white">{ fmt.Sprintf("%.1f°", bike.StaDeg) }</span>
			</div>
			<div class="bg-slate-950/60 p-2.5 rounded-lg border border-slate-800">
				<span class="text-[11px] text-slate-400 uppercase tracking-wider block font-sans">HTL</span>
				<span class="text-base font-bold text-white">{ fmt.Sprintf("%.0f", bike.Htl) } <span class="text-xs font-normal text-slate-400 font-sans">mm</span></span>
			</div>
			<div class="bg-slate-950/60 p-2.5 rounded-lg border border-slate-800">
				<span class="text-[11px] text-slate-400 uppercase tracking-wider block font-sans">BB Drop</span>
				<span class="text-base font-bold text-pink-400">{ fmt.Sprintf("%.0f", bike.BbDrop) } <span class="text-xs font-normal text-slate-400 font-sans">mm</span></span>
			</div>
			<div class="bg-slate-950/60 p-2.5 rounded-lg border border-slate-800">
				<span class="text-[11px] text-slate-400 uppercase tracking-wider block font-sans">Fork Rake</span>
				<span class="text-base font-bold text-white">{ fmt.Sprintf("%.0f", bike.ForkRake) } <span class="text-xs font-normal text-slate-400 font-sans">mm</span></span>
			</div>
			<div class="bg-slate-950/60 p-2.5 rounded-lg border border-slate-800">
				<span class="text-[11px] text-slate-400 uppercase tracking-wider block font-sans">Wheelbase</span>
				<span class="text-base font-bold text-white">{ fmt.Sprintf("%.0f", bike.Wheelbase) } <span class="text-xs font-normal text-slate-400 font-sans">mm</span></span>
			</div>
		</div>
	</div>
}

templ ValidatorProofs(bike model.BikeGeometry, report model.ValidationReport) {
	<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
		<!-- Master Stack Equation Proof -->
		<div class="bg-slate-900 border border-slate-800 rounded-xl p-5 shadow-md">
			<div class="flex items-center gap-2 mb-3">
				<div class="p-1.5 rounded-lg bg-amber-500/10 text-amber-400">
					<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
					</svg>
				</div>
				<h3 class="text-base font-semibold text-white">Master Stack Equation Proof</h3>
			</div>
			<p class="text-xs text-slate-400 mb-4">
				Reverse-engineers the CAD baseline to verify if published Stack matches the physical front-end.
			</p>

			<div class="bg-slate-950 p-3.5 rounded-lg font-mono text-xs text-slate-300 border border-slate-800 mb-4 overflow-x-auto">
				<div class="text-slate-500">{ "// Master Stack Equation" }</div>
				<div class="text-amber-300 mt-1">
					Stack = BB_Drop - Rake·cos(HTA) + (A2C + Cup + HTL)·sin(HTA)
				</div>
				<div class="text-slate-500 mt-2">{ "// Derived Geometric A2C" }</div>
				<div class="text-cyan-300 mt-1">
					{ fmt.Sprintf("Geometric A2C = (%.0f - %.0f + %.0f·cos(%.1f°)) / sin(%.1f°) - %.0f",
						bike.Stack, bike.BbDrop, bike.ForkRake, bike.HtaDeg, bike.HtaDeg, bike.Htl) }
				</div>
				<div class="text-emerald-400 font-bold mt-2">
					{ fmt.Sprintf("= %.1f mm (Fork A2C) + %.1f mm (Cup Stack) = %.1f mm",
						report.GeometricA2c, report.CupStack, report.TotalStructuralA2c) }
				</div>
			</div>

			<div class="space-y-3">
				<div class="flex justify-between items-center text-sm py-1.5 border-b border-slate-800">
					<span class="text-slate-400">Published Fork A2C (Static):</span>
					<span class="font-semibold text-slate-200 font-mono">
						if bike.ForkA2c > 0 {
							{ fmt.Sprintf("%.0f mm", bike.ForkA2c) }
						} else {
							<span>Not specified</span>
						}
					</span>
				</div>
				<div class="flex justify-between items-center text-sm py-1.5 border-b border-slate-800">
					<span class="text-slate-400">Reverse-Engineered CAD A2C:</span>
					<span class="font-semibold text-cyan-400 font-mono">{ fmt.Sprintf("%.1f mm", report.GeometricA2c) }</span>
				</div>
				<div class="flex justify-between items-center text-sm py-1.5 border-b border-slate-800">
					<span class="text-slate-400">Axle-to-Crown Deviation (Δ):</span>
					<span class={ "font-semibold font-mono",
						templ.KV("text-emerald-400", isWithinStaticTolerance(report.A2cDifference)),
						templ.KV("text-amber-400", isWithinSaggedRange(report.A2cDifference)),
						templ.KV("text-rose-400", isMismatched(report.A2cDifference)) }>
						if report.A2cDifference != nil {
							{ fmt.Sprintf("%+.1f mm", *report.A2cDifference) }
						} else {
							<span>N/A</span>
						}
					</span>
				</div>
				<div class="flex justify-between items-center text-sm py-1.5">
					<span class="text-slate-400">Inferred Published Mode:</span>
					<span class="font-semibold text-slate-200">
						if report.InferredPublishMode == model.ModeStaticCad {
							<span>🟢 Static (0% Sag) Chart</span>
						} else if report.InferredPublishMode == model.ModeSaggedCad {
							<span>🟡 Sagged CAD (~20% Sag)</span>
						} else if report.InferredPublishMode == model.ModeMismatchedCad {
							<span>🔴 Mismatched / Inconsistent</span>
						} else {
							<span>Unspecified</span>
						}
					</span>
				</div>
			</div>
		</div>

		<!-- Headset Reality & Hardtail Dynamics -->
		<div class="bg-slate-900 border border-slate-800 rounded-xl p-5 shadow-md flex flex-col justify-between">
			<div>
				<div class="flex items-center gap-2 mb-3">
					<div class="p-1.5 rounded-lg bg-indigo-500/10 text-indigo-400">
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
						</svg>
					</div>
					<h3 class="text-base font-semibold text-white">Headset Reality & Hardtail Dynamics</h3>
				</div>
				<p class="text-xs text-slate-400 mb-4">
					Physical headset cups and hardtail pitch geometry constraints.
				</p>

				<div class="space-y-3.5">
					<div class="p-3 rounded-lg bg-slate-950 border border-slate-800">
						<div class="flex items-center justify-between text-sm">
							<span class="text-slate-400">Head Tube & Headset Type:</span>
							<span class="font-semibold text-indigo-300 font-mono">
								if bike.HeadsetCupType != "" {
									{ string(bike.HeadsetCupType) }
								} else {
									<span>Standard Tapered</span>
								}
							</span>
						</div>
						<div class="flex items-center justify-between text-sm mt-2">
							<span class="text-slate-400">Lower Cup Stack:</span>
							<span class="font-semibold text-slate-200 font-mono">{ fmt.Sprintf("%.1f mm", report.CupStack) }</span>
						</div>
					</div>

					if bike.HeadsetCupType == model.CupEC44 {
						<div class="p-3 rounded-lg bg-amber-500/10 border border-amber-500/20 text-xs text-amber-300">
							<div class="font-semibold flex items-center gap-1.5 mb-1">
								<svg class="w-4 h-4 text-amber-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
								</svg>
								<span>EC44 Lower External Cup Detected</span>
							</div>
							<span>Frames with straight 44mm head tubes running tapered steerers require an external lower cup (EC44/40). This adds <strong>12mm</strong> of physical structural height below the head tube that slackens the frame by ~0.5° compared to zero-stack (ZS) designs.</span>
						</div>
					} else {
						<div class="p-3 rounded-lg bg-slate-950 border border-slate-800 text-xs text-slate-400">
							<div class="font-semibold text-slate-300 mb-1">Internal / Zero-Stack (ZS/IS)</div>
							<span>Tapered head tubes (e.g. ZS44/56 or IS52) have internal lower cups with minimal stack (0–2mm).</span>
						</div>
					}

					<!-- Front Center Check -->
					<div class="p-3 rounded-lg bg-slate-950 border border-slate-800 text-xs">
						<div class="flex justify-between items-center text-sm">
							<span class="text-slate-400">Calculated Front Center:</span>
							<span class="font-semibold text-slate-200 font-mono">
								{ fmt.Sprintf("%.1f mm", report.FrontCenterCalc) }
							</span>
						</div>
						if bike.FrontCenter > 0 {
							<div class="flex justify-between items-center text-sm mt-1">
								<span class="text-slate-400">Published Front Center:</span>
								<span class="font-semibold text-slate-200 font-mono">
									{ fmt.Sprintf("%.1f mm", bike.FrontCenter) }
								</span>
							</div>
						}
					</div>
				</div>
			</div>
		</div>
	</div>
}

templ ValidatorLog(issues []model.ValidationIssue) {
	<div class="bg-slate-900 border border-slate-800 rounded-xl p-5 shadow-md">
		<h3 class="text-base font-semibold text-white mb-3 flex items-center gap-2">
			<span>Validation Diagnostic Log</span>
			<span class="text-xs px-2 py-0.5 rounded-full bg-slate-800 text-slate-300 font-mono">
				{ fmt.Sprintf("%d Notices", len(issues)) }
			</span>
		</h3>

		<div class="space-y-3">
			for _, issue := range issues {
				<div
					class={ "p-3.5 rounded-lg border text-sm flex items-start gap-3",
						templ.KV("bg-rose-500/10 border-rose-500/30 text-rose-200", issue.Severity == model.SeverityError),
						templ.KV("bg-amber-500/10 border-amber-500/30 text-amber-200", issue.Severity == model.SeverityWarning),
						templ.KV("bg-emerald-500/10 border-emerald-500/30 text-emerald-200", issue.Severity == model.SeveritySuccess),
						templ.KV("bg-blue-500/10 border-blue-500/30 text-blue-200", issue.Severity == model.SeverityInfo) }
				>
					<div class="shrink-0 mt-0.5">
						if issue.Severity == model.SeverityError {
							<svg class="w-5 h-5 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
						} else if issue.Severity == model.SeverityWarning {
							<svg class="w-5 h-5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
						} else if issue.Severity == model.SeveritySuccess {
							<svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
						} else {
							<svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
						}
					</div>

					<div class="flex-1">
						<div class="font-semibold">{ issue.Title }</div>
						<div class="text-xs mt-0.5 opacity-90">{ issue.Message }</div>
						if issue.Details != "" {
							<div class="text-xs mt-1 opacity-75 font-mono">{ issue.Details }</div>
						}
						if issue.Expected != "" || issue.Actual != "" {
							<div class="text-xs mt-1.5 flex gap-4 font-mono opacity-80">
								if issue.Expected != "" {
									<span>Expected: { issue.Expected }</span>
								}
								if issue.Actual != "" {
									<span>Calculated: { issue.Actual }</span>
								}
							</div>
						}
					</div>
				</div>
			}
		</div>
	</div>
}

templ SagSimulatorResults(bike model.BikeGeometry, simSagPercent float64, dynPose model.DynamicGeometryResult) {
	{{
		simSagMm := ((bike.ForkTravelMm) * simSagPercent) / 100.0
		if bike.ForkTravelMm <= 0 {
			simSagMm = (120.0 * simSagPercent) / 100.0
		}
	}}
	<div class="space-y-4">
		<div class="grid grid-cols-2 sm:grid-cols-5 gap-3 p-3 bg-slate-950 rounded-lg border border-slate-800 text-center font-mono">
			<div>
				<span class="text-[11px] text-slate-400 uppercase tracking-wider block font-sans">Head Angle</span>
				<span class="text-base font-bold text-white">
					{ fmt.Sprintf("%.2f°", dynPose.NewHta) }
					<span class="text-xs font-normal text-emerald-400 ml-1">
						({ formatDelta(dynPose.DeltaAngleDeg, "°") })
					</span>
				</span>
			</div>
			<div>
				<span class="text-[11px] text-slate-400 uppercase tracking-wider block font-sans">Seat Angle</span>
				<span class="text-base font-bold text-white">
					{ fmt.Sprintf("%.2f°", dynPose.NewSta) }
					<span class="text-xs font-normal text-emerald-400 ml-1">
						({ formatDelta(dynPose.DeltaAngleDeg, "°") })
					</span>
				</span>
			</div>
			<div>
				<span class="text-[11px] text-slate-400 uppercase tracking-wider block font-sans">Dynamic Reach</span>
				<span class="text-base font-bold text-cyan-400">
					{ fmt.Sprintf("%.1f", dynPose.NewReach) } <span class="text-xs font-normal text-slate-400">mm</span>
					<span class="text-xs font-normal text-slate-400 ml-1">
						({ formatDelta(dynPose.DeltaReach, "") })
					</span>
				</span>
			</div>
			<div>
				<span class="text-[11px] text-slate-400 uppercase tracking-wider block font-sans">Dynamic Stack</span>
				<span class="text-base font-bold text-amber-400">
					{ fmt.Sprintf("%.1f", dynPose.NewStack) } <span class="text-xs font-normal text-slate-400">mm</span>
					<span class="text-xs font-normal text-slate-400 ml-1">
						({ formatDelta(dynPose.DeltaStack, "") })
					</span>
				</span>
			</div>
			<div>
				<span class="text-[11px] text-slate-400 uppercase tracking-wider block font-sans">Dynamic BB Drop</span>
				<span class="text-base font-bold text-pink-400">
					{ fmt.Sprintf("%.1f", dynPose.NewBbDrop) } <span class="text-xs font-normal text-slate-400">mm</span>
					<span class="text-xs font-normal text-slate-400 ml-1">
						({ formatDelta(dynPose.DeltaBbDrop, "") })
					</span>
				</span>
			</div>
		</div>

		<div class="text-xs text-slate-400 flex justify-between items-center px-1">
			<span>Compression: <strong class="text-cyan-400 font-mono">{ fmt.Sprintf("%.1f mm", simSagMm) }</strong> travel</span>
			<span>Total Pitched A2C: <strong class="text-slate-200 font-mono">{ fmt.Sprintf("%.1f mm", dynPose.TotalNewA2c) }</strong></span>
		</div>

		{{
			dynFit := model.BikeFitAnalysis{
				ActiveReach:   dynPose.NewReach,
				ActiveStack:   dynPose.NewStack,
				ActiveHta:     dynPose.NewHta,
				ActiveSta:     dynPose.NewSta,
				ActiveBbDrop:  dynPose.NewBbDrop,
				StructuralA2c: dynPose.TotalNewA2c,
			}
		}}
		@BikeDiagram(bike, &dynFit, 750, simSagPercent > 0)
	</div>
}

templ ValidatorView(
	bikes []model.BikeGeometry,
	inspectedBike model.BikeGeometry,
	report model.ValidationReport,
	simSagPercent float64,
	dynPose model.DynamicGeometryResult,
) {
	<div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
		@ValidatorSidebar(bikes, inspectedBike.ID, report)

		<div class="lg:col-span-3 space-y-6">
			@ValidatorHeader(inspectedBike, report)
			@ValidatorProofs(inspectedBike, report)
			@ValidatorLog(report.Issues)

			<!-- Dynamic Hardtail Sag Simulator -->
			<div class="bg-slate-900 border border-slate-800 rounded-xl p-5 shadow-md">
				<div class="flex flex-wrap items-center justify-between gap-4 mb-4">
					<div class="flex items-center gap-2">
						<div class="p-1.5 rounded-lg bg-cyan-500/10 text-cyan-400">
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path>
							</svg>
						</div>
						<div>
							<h3 class="text-base font-semibold text-white">Dynamic Hardtail Sag Simulator</h3>
							<p class="text-xs text-slate-400">
								Hardtails compress only at the front axle, pitching around the rear wheel.
							</p>
						</div>
					</div>

					<div class="flex items-center gap-3">
						<span class="text-sm font-medium text-slate-300">Sag:</span>
						<input
							type="range"
							name="sag"
							min="0"
							max="35"
							step="1"
							value={ fmt.Sprintf("%.0f", simSagPercent) }
							hx-get={ fmt.Sprintf("/validator/sag?id=%s", inspectedBike.ID) }
							hx-trigger="input changed delay:100ms"
							hx-target="#sag-simulator-results"
							class="w-36 accent-cyan-400 cursor-pointer"
						/>
						<span class="text-base font-bold font-mono text-cyan-400 w-12 text-right">
							{ fmt.Sprintf("%.0f%%", simSagPercent) }
						</span>
					</div>
				</div>

				<div id="sag-simulator-results">
					@SagSimulatorResults(inspectedBike, simSagPercent, dynPose)
				</div>
			</div>
		</div>
	</div>
}
