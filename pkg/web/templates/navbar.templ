package templates

import "fmt"

templ Navbar(activeTab string, bikeCount int) {
	@navbarContent(activeTab, bikeCount, false)
}

templ NavbarOOB(activeTab string, bikeCount int) {
	@navbarContent(activeTab, bikeCount, true)
}

templ navbarContent(activeTab string, bikeCount int, oob bool) {
	if oob {
		<header id="main-navbar" hx-swap-oob="true" class="border-b border-slate-800 bg-slate-900/80 backdrop-blur sticky top-0 z-30">
			@navbarInner(activeTab, bikeCount)
		</header>
	} else {
		<header id="main-navbar" class="border-b border-slate-800 bg-slate-900/80 backdrop-blur sticky top-0 z-30">
			@navbarInner(activeTab, bikeCount)
		</header>
	}
}

templ navbarInner(activeTab string, bikeCount int) {
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="flex items-center justify-between h-16">
			<!-- Brand -->
			<div class="flex items-center gap-3">
				<div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-amber-500 to-amber-300 flex items-center justify-center text-slate-950 font-black text-xl shadow-lg shadow-amber-500/20">
					🚲
				</div>
				<div>
					<div class="flex items-center gap-2">
						<h1 class="text-lg font-bold text-white tracking-tight">BikeGeo Analyst</h1>
						<span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-amber-500/10 text-amber-300 border border-amber-500/20 font-semibold">
							GO + HTMX
						</span>
					</div>
					<p class="text-xs text-slate-400">
						Apples-to-Apples Hardtail Geometry & CAD Proofs
					</p>
				</div>
			</div>

			<!-- Navigation Tabs -->
			<div class="flex items-center gap-1 bg-slate-950/80 p-1 rounded-xl border border-slate-800">
				<button
					hx-get="/?tab=compare"
					hx-target="#app-content"
					hx-push-url="/?tab=compare"
					class={ "px-3.5 py-1.5 rounded-lg text-xs font-semibold transition flex items-center gap-2",
						templ.KV("bg-amber-500 text-slate-950 shadow-md", activeTab == "compare"),
						templ.KV("text-slate-400 hover:text-white hover:bg-slate-900", activeTab != "compare") }
				>
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
					</svg>
					<span>Apples-to-Apples Compare</span>
				</button>

				<button
					hx-get="/?tab=validator"
					hx-target="#app-content"
					hx-push-url="/?tab=validator"
					class={ "px-3.5 py-1.5 rounded-lg text-xs font-semibold transition flex items-center gap-2",
						templ.KV("bg-amber-500 text-slate-950 shadow-md", activeTab == "validator"),
						templ.KV("text-slate-400 hover:text-white hover:bg-slate-900", activeTab != "validator") }
				>
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
					</svg>
					<span>Master Stack CAD Proof</span>
				</button>
			</div>

			<!-- Actions -->
			<div class="flex items-center gap-3">
				<span class="text-xs font-mono px-2.5 py-1 rounded-lg bg-slate-950 border border-slate-800 text-slate-300">
					{ fmt.Sprintf("%d Frame Models", bikeCount) }
				</span>

				<button
					hx-get="/bikes/new"
					hx-target="#app-content"
					hx-push-url="/bikes/new"
					class="px-3.5 py-1.5 rounded-lg bg-amber-500 hover:bg-amber-400 text-slate-950 text-xs font-bold transition flex items-center gap-1.5 shadow-md shadow-amber-500/10 cursor-pointer"
				>
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
					</svg>
					<span>Add Bike</span>
				</button>
			</div>
		</div>
	</div>
}

templ Footer() {
	<footer class="border-t border-slate-800/80 bg-slate-950 py-4 mt-auto text-center text-xs text-slate-500">
		<div class="max-w-7xl mx-auto px-4 flex flex-wrap items-center justify-between gap-2">
			<div>
				BikeGeo Analyst • Rigorous 2D Cartesian Frame Geometry Model • Local JSON Storage
			</div>
			<div class="font-mono text-slate-400">
				Go + templ + HTMX + Tailwind CSS
			</div>
		</div>
	</footer>
}
